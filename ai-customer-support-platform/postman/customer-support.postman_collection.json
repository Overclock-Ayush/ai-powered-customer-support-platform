{
  "info": {
    "name": "AI Customer Support Platform",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "baseUrl", "value": "http://localhost:8080"},
    {"key": "token", "value": ""},
    {"key": "ticketId", "value": ""}
  ],
  "item": [
    {
      "name": "Register Customer",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "options": {"raw": {"language": "json"}},
          "raw": "{\n  \"email\": \"newcustomer@example.com\",\n  \"password\": \"Customer@12345\",\n  \"fullName\": \"New Customer\"\n}"
        }
      }
    },
    {
      "name": "Login Demo Customer",
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "const json = pm.response.json();",
            "if (json.token) pm.collectionVariables.set('token', json.token);"
          ],
          "type": "text/javascript"
        }
      }],
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "options": {"raw": {"language": "json"}},
          "raw": "{\n  \"email\": \"customer@example.com\",\n  \"password\": \"Customer@12345\"\n}"
        }
      }
    },
    {
      "name": "Create Ticket",
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "const json = pm.response.json();",
            "if (json.id) pm.collectionVariables.set('ticketId', json.id);"
          ],
          "type": "text/javascript"
        }
      }],
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"},
          {"key": "Authorization", "value": "Bearer {{token}}"}
        ],
        "url": "{{baseUrl}}/api/tickets",
        "body": {
          "mode": "raw",
          "options": {"raw": {"language": "json"}},
          "raw": "{\n  \"subject\": \"I was charged twice\",\n  \"description\": \"I see two charges for the same order. Please help.\"\n}"
        }
      }
    },
    {
      "name": "List Tickets",
      "request": {
        "method": "GET",
        "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
        "url": "{{baseUrl}}/api/tickets"
      }
    },
    {
      "name": "AI Analyze Ticket",
      "request": {
        "method": "POST",
        "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
        "url": "{{baseUrl}}/api/tickets/{{ticketId}}/ai/analyze"
      }
    },
    {
      "name": "AI Draft Reply (RAG)",
      "request": {
        "method": "POST",
        "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
        "url": "{{baseUrl}}/api/tickets/{{ticketId}}/ai/reply"
      }
    },
    {
      "name": "List Knowledge",
      "request": {
        "method": "GET",
        "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
        "url": "{{baseUrl}}/api/knowledge"
      }
    }
  ]
}
