{
  "family": "ai-customer-support-platform",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/ai-support-task-role",
  "containerDefinitions": [
    {
      "name": "support-app",
      "image": "<ACCOUNT_ID>.dkr.ecr.<AWS_REGION>.amazonaws.com/ai-customer-support-platform:latest",
      "essential": true,
      "portMappings": [{"containerPort": 8080, "protocol": "tcp"}],
      "environment": [
        {"name": "PORT", "value": "8080"},
        {"name": "DB_URL", "value": "jdbc:postgresql://<RDS_ENDPOINT>:5432/supportdb"},
        {"name": "DB_USERNAME", "value": "support"},
        {"name": "DB_PASSWORD", "value": "CHANGE_ME"},
        {"name": "JWT_SECRET", "value": "CHANGE_ME_LONG_RANDOM_SECRET"},
        {"name": "DEMO_DATA_ENABLED", "value": "false"},
        {"name": "OPENAI_CHAT_MODEL", "value": "gpt-4o-mini"},
        {"name": "OPENAI_EMBEDDING_MODEL", "value": "text-embedding-3-small"}
      ],
      "secrets": [
        {"name": "OPENAI_API_KEY", "valueFrom": "arn:aws:secretsmanager:<AWS_REGION>:<ACCOUNT_ID>:secret:ai-support/openai"}
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -f http://localhost:8080/actuator/health || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 30
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/ai-customer-support-platform",
          "awslogs-region": "<AWS_REGION>",
          "awslogs-stream-prefix": "support"
        }
      }
    }
  ]
}
